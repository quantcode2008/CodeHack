# ============================================================================
# Commons — Campus Resource Sharing Platform
# Environment Variables Template
# ============================================================================

# Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Campus Identity & Domain
NEXT_PUBLIC_CAMPUS_NAME="Eastbrook Institute of Technology"
NEXT_PUBLIC_CAMPUS_DOMAIN="eastbrook.edu"

# Google Gemini API (Server-side only — never exposed to client)
# If omitted, system seamlessly runs deterministic collegiate heuristic fallbacks
GEMINI_API_KEY=your-gemini-api-key-here
